FROM node:24-alpine AS builder
ENV COREPACK_HOME=/corepack
RUN npm install -g corepack \
	&& corepack enable

WORKDIR /app

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --frozen-lockfile

COPY . .
RUN pnpm run sync
# Required for build-time validation; production values are provided at runtime.
RUN PUBLIC_ORIGIN=http://localhost \
	COOKIE_PREFIX=build \
	DATABASE_URL=postgres://build:build@localhost/build \
	pnpm run build
RUN pnpm prune --production

FROM node:24-alpine AS runtime
WORKDIR /app

COPY --from=builder --chown=node:node /app/build build/
COPY --from=builder --chown=node:node /app/node_modules node_modules/

COPY --chown=node:node package.json .
COPY --chown=node:node drizzle.config.ts .
COPY --chown=node:node ./src/lib/server/db ./src/lib/server/db
COPY --chown=node:node ./src/lib/server/crypto.ts ./src/lib/server/crypto.ts

USER node
ENV NODE_ENV=production
ENV PNPM_CONFIG_VERIFY_DEPS_BEFORE_RUN=false
CMD ["node", "build"]
